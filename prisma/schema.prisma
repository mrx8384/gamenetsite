// ATOM GAME CLUB — database schema
// Conventions:
// - Money columns are BigInt Rials (displayed as Toman in the UI).
// - Table names are snake_case plural via @@map; columns keep camelCase.
// - CHECK constraints that Prisma cannot express live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity & access ─────────────────────────

enum Role {
  ADMIN
  USER
  PARTNER
  /// Support agent: only the support inbox in the admin panel.
  SUPPORT
}

model User {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(100)
  /// Stored lowercased. At least one of email/phone is required (CHECK).
  email           String?   @unique @db.VarChar(254)
  /// Normalized Iranian mobile, e.g. 09121234567.
  phone           String?   @unique @db.VarChar(11)
  passwordHash    String
  role            Role      @default(USER)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  /// Bumped on logout-all, password change or role change to invalidate sessions.
  sessionVersion  Int       @default(0)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions             Session[]
  addresses            Address[]
  verificationCodes    VerificationCode[]
  cart                 Cart?
  orders               Order[]
  newsPosts            NewsPost[]
  partnerProfile       PartnerProfile?         @relation("PartnerOwner")
  reviewedPartners     PartnerProfile[]        @relation("PartnerReviewer")
  auditLogs            AuditLog[]
  uploadedMedia        Media[]
  inventoryMovements   InventoryMovement[]
  statusChanges        OrderStatusHistory[]
  catalogImports       CatalogImportRun[]
  pagesUpdated         Page[]
  organizedTournaments Tournament[]            @relation("TournamentOrganizer")
  tournamentEntries    TournamentParticipant[]
  supportConversation  SupportConversation?
  supportMessages      SupportMessage[]
  gamePoints           GamePointsEntry[]
  gameAchievements     GameAchievementUnlock[]
  rewardRedemptions    RewardRedemption[]      @relation("RewardOwner")
  rewardsChecked       RewardRedemption[]      @relation("RewardStaff")

  @@index([role])
  @@map("users")
}

/// Database session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @db.Char(64)
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(300)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum VerificationChannel {
  EMAIL
  SMS
}

enum VerificationPurpose {
  PASSWORD_RESET
  VERIFY_EMAIL
  VERIFY_PHONE
  LOGIN
}

/// One-time codes / links for email and SMS flows. Only a hash is stored.
model VerificationCode {
  id        String              @id @default(cuid())
  userId    String?
  channel   VerificationChannel
  /// Email address or phone number the code was sent to.
  target    String              @db.VarChar(254)
  purpose   VerificationPurpose
  codeHash  String
  attempts  Int                 @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
  @@map("verification_codes")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  title         String?  @db.VarChar(50)
  recipientName String   @db.VarChar(100)
  phone         String   @db.VarChar(11)
  province      String   @db.VarChar(50)
  city          String   @db.VarChar(50)
  postalCode    String   @db.VarChar(10)
  line          String   @db.VarChar(300)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// Fixed-window rate limit counters (login, register, OTP, contact form...).
model RateLimitBucket {
  key     String   @id @db.VarChar(200)
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String?  @db.VarChar(50)
  meta      Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Uploaded files. Bytes live in storage (UPLOAD_DIR / S3), not in the DB.
model Media {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  originalName String?  @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  size         Int
  width        Int?
  height       Int?
  sha256       String?  @db.Char(64)
  uploaderId   String?
  createdAt    DateTime @default(now())

  uploader       User?          @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  productImages  ProductImage[]
  categoryImages Category[]
  newsCovers     NewsPost[]
  catalogGames   CatalogGame[]
  organizations  ContractOrganization[]
  parkAttractions ParkAttraction[]

  @@index([sha256])
  @@map("media")
}

// ───────────────────────────── Store ─────────────────────────────

model Category {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(80)
  slug           String   @unique @db.VarChar(100)
  description    String?
  parentId       String?
  imageId        String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  /// Hide prices in this category (and its sub-categories): show "call for price" instead; not purchasable online.
  priceOnRequest Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  image    Media?     @relation(fields: [imageId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([parentId])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  title            String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(220)
  sku              String        @unique @db.VarChar(64)
  shortDescription String?       @db.VarChar(500)
  descriptionJson  Json?
  descriptionHtml  String?
  price            BigInt
  compareAtPrice   BigInt?
  /// CHECK (stock >= 0). Changed only together with an InventoryMovement.
  stock            Int           @default(0)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  /// Homepage order among featured products (Admin → تنظیمات سایت → فروش). Lower first.
  featuredSort     Int           @default(0)
  categoryId       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]

  @@index([status, categoryId])
  @@index([isFeatured, featuredSort])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  mediaId   String
  alt       String? @db.VarChar(200)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@map("product_images")
}

enum InventoryReason {
  MANUAL
  ORDER
  ORDER_CANCEL
  RETURN
  CORRECTION
}

model InventoryMovement {
  id        String          @id @default(cuid())
  productId String
  delta     Int
  reason    InventoryReason
  note      String?         @db.VarChar(300)
  orderId   String?
  actorId   String?
  createdAt DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model Cart {
  id             String    @id @default(cuid())
  userId         String?   @unique
  /// Hash of the signed guest cookie token (guest carts only).
  guestTokenHash String?   @unique
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  /// CHECK (quantity > 0)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ───────────────────────── Orders & payments ─────────────────────────

enum ShippingType {
  /// Fixed cost, paid online together with the order.
  PREPAID
  /// «پس‌کرایه»: the carrier sets the cost and collects it on delivery (not via the site's gateway).
  COLLECT
}

/// Shipping companies / methods managed by the admin.
model ShippingMethod {
  id          String       @id @default(cuid())
  name        String       @db.VarChar(100)
  description String?      @db.VarChar(300)
  type        ShippingType
  /// Rials; used only for PREPAID.
  price       BigInt       @default(0)
  /// Optional tracking page, e.g. "https://carrier.ir/track?code={code}".
  trackingUrl String?      @db.VarChar(300)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orders Order[]

  @@map("shipping_methods")
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                 String        @id @default(cuid())
  /// Human-readable order number shown to customers.
  number             String        @unique @db.VarChar(20)
  userId             String
  status             OrderStatus   @default(PENDING)
  subtotal           BigInt
  shippingCost       BigInt        @default(0)
  discount           BigInt        @default(0)
  total              BigInt
  // Shipping snapshot (copied from the address at checkout)
  recipientName      String        @db.VarChar(100)
  phone              String        @db.VarChar(11)
  province           String        @db.VarChar(50)
  city               String        @db.VarChar(50)
  postalCode         String        @db.VarChar(10)
  addressLine        String        @db.VarChar(300)
  customerNote       String?       @db.VarChar(500)
  adminNote          String?
  // Shipping snapshot (method may be edited or deleted later)
  shippingMethodId   String?
  shippingMethodName String?       @db.VarChar(100)
  shippingType       ShippingType?
  trackingCode       String?       @db.VarChar(100)
  trackingUrl        String?       @db.VarChar(300)
  /// Unpaid orders past this time are cancelled and their stock is released.
  paymentDeadline    DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingMethod     ShippingMethod?      @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]
  inventoryMovements InventoryMovement[]
  rewardRedemption   RewardRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String?
  titleSnapshot String  @db.VarChar(200)
  skuSnapshot   String  @db.VarChar(64)
  unitPrice     BigInt
  /// CHECK (quantity > 0)
  quantity      Int
  lineTotal     BigInt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  actorId   String?
  note      String?      @db.VarChar(500)
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  CANCELLED
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String?
  /// Provider key, e.g. "zarinpal". "disabled" while no gateway is configured.
  provider      String        @db.VarChar(30)
  status        PaymentStatus @default(INITIATED)
  amount        BigInt
  authority     String?       @db.VarChar(100)
  referenceId   String?       @db.VarChar(100)
  cardPanMasked String?       @db.VarChar(20)
  raw           Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription PartnerSubscription?

  @@unique([provider, authority])
  @@index([orderId])
  @@map("payments")
}

// ───────────────────────────── Content ─────────────────────────────

model NewsCategory {
  id        String     @id @default(cuid())
  name      String     @db.VarChar(80)
  slug      String     @unique @db.VarChar(100)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     NewsPost[]

  @@map("news_categories")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model NewsPost {
  id           String     @id @default(cuid())
  title        String     @db.VarChar(200)
  slug         String     @unique @db.VarChar(220)
  excerpt      String?    @db.VarChar(500)
  contentJson  Json?
  /// Sanitized on save.
  contentHtml  String     @default("")
  coverMediaId String?
  status       PostStatus @default(DRAFT)
  isFeatured   Boolean    @default(false)
  publishedAt  DateTime?
  authorId     String?
  categoryId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cover    Media?        @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("news_posts")
}

/// Editable static pages (e.g. slug "about").
model Page {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(100)
  title       String   @db.VarChar(200)
  contentJson Json?
  contentHtml String   @default("")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("pages")
}

/// Key/value site settings (contact info, social links, payment toggle, hero text...).
model SiteSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(100)
  email     String?       @db.VarChar(254)
  phone     String?       @db.VarChar(11)
  subject   String        @db.VarChar(200)
  body      String        @db.VarChar(5000)
  status    ContactStatus @default(NEW)
  ipHash    String?       @db.Char(64)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

// ───────────────────────── Partners & subscriptions ─────────────────────────

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PartnerBusinessType {
  GAME_NET
  STORE
  ESPORTS_TEAM
  OTHER
}

model PartnerProfile {
  id              String              @id @default(cuid())
  userId          String              @unique
  businessName    String              @db.VarChar(150)
  businessType    PartnerBusinessType
  province        String              @db.VarChar(50)
  city            String              @db.VarChar(50)
  address         String              @db.VarChar(300)
  phone           String              @db.VarChar(11)
  website         String?             @db.VarChar(200)
  instagram       String?             @db.VarChar(100)
  description     String?             @db.VarChar(2000)
  status          PartnerStatus       @default(PENDING)
  /// Last time the application was (re)submitted; review queue order.
  submittedAt     DateTime            @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?             @db.VarChar(500)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user          User                  @relation("PartnerOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy    User?                 @relation("PartnerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  subscriptions PartnerSubscription[]

  @@index([status, submittedAt])
  @@map("partner_profiles")
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(1000)
  price        BigInt
  durationDays Int
  /// Entitlement keys granted by this plan, e.g. ["GAMEPAD_TESTER"].
  features     String[]
  /// Plans cannot be purchased until enabled (all disabled for now).
  isActive     Boolean  @default(false)
  /// Shown on the partners page and dashboard (marked «به‌زودی» while purchasing is disabled).
  isVisible    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions PartnerSubscription[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  EXPIRED
  CANCELLED
}

model PartnerSubscription {
  id        String             @id @default(cuid())
  partnerId String
  planId    String
  status    SubscriptionStatus @default(INACTIVE)
  startsAt  DateTime?
  endsAt    DateTime?
  paymentId String?            @unique
  note      String?            @db.VarChar(500)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  partner PartnerProfile   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([partnerId, status])
  @@map("partner_subscriptions")
}

// ───────────────────────────── Game Catalog ─────────────────────────────
// Ported from the original Python app (see docs/GAME_CATALOG_ANALYSIS.md).

enum CatalogPlatform {
  PS4
  PS5
}

model CatalogCategory {
  id        Int             @id @default(autoincrement())
  platform  CatalogPlatform
  name      String          @db.VarChar(40)
  position  Int             @default(0)
  /// The locked «بدون دسته» category of each platform.
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  games CatalogGame[]

  @@unique([platform, name])
  @@index([platform, position])
  @@map("catalog_categories")
}

model CatalogGame {
  /// 12 lowercase hex chars, same format (and same values for imported games) as the original app.
  id          String          @id @db.VarChar(12)
  name        String          @db.VarChar(80)
  platform    CatalogPlatform
  categoryId  Int
  imageId     String
  /// Display order within the platform (original insertion order; new games go last).
  position    Int             @default(0)
  importRunId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category  CatalogCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  image     Media             @relation(fields: [imageId], references: [id], onDelete: Restrict)
  importRun CatalogImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@index([platform, position])
  @@index([categoryId])
  @@map("catalog_games")
}

/// Traceability for imports from the original SQLite catalog.
model CatalogImportRun {
  id                 String   @id @default(cuid())
  sourceFileName     String   @db.VarChar(255)
  sourceSha256       String   @db.Char(64)
  schemaVersion      Int
  gamesImported      Int
  categoriesImported Int
  actorId            String?
  createdAt          DateTime @default(now())

  actor User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  games CatalogGame[]

  @@map("catalog_import_runs")
}

// ───────────────────────────── Tournaments ─────────────────────────────
// Organizer = admin or an entitled partner. Results are entered by the organizer only.

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  GROUPS_KNOCKOUT
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchStage {
  WINNERS
  LOSERS
  GRAND_FINAL
  GRAND_FINAL_RESET
  THIRD_PLACE
  ROUND_ROBIN
  GROUP
}

enum MatchStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model Tournament {
  id                    String           @id @default(cuid())
  slug                  String           @unique @db.VarChar(120)
  name                  String           @db.VarChar(120)
  game                  String           @db.VarChar(80)
  platform              String?          @db.VarChar(40)
  description           String?          @db.VarChar(3000)
  rules                 String?          @db.VarChar(5000)
  prize                 String?          @db.VarChar(500)
  entryFeeNote          String?          @db.VarChar(200)
  startsAt              DateTime?
  format                TournamentFormat
  status                TournamentStatus @default(DRAFT)
  maxParticipants       Int?
  allowSelfRegistration Boolean          @default(true)
  thirdPlaceMatch       Boolean          @default(false)
  doubleRoundRobin      Boolean          @default(false)
  groupCount            Int?
  advancePerGroup       Int?
  /// Group stage finished and the knockout bracket was generated (GROUPS_KNOCKOUT only).
  knockoutStarted       Boolean          @default(false)
  pointsWin             Int              @default(3)
  pointsDraw            Int              @default(1)
  pointsLoss            Int              @default(0)
  organizerId           String?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organizer    User?                   @relation("TournamentOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  participants TournamentParticipant[]
  matches      TournamentMatch[]

  @@index([status, startsAt])
  @@index([organizerId])
  @@map("tournaments")
}

model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String?
  name         String   @db.VarChar(60)
  seed         Int
  groupIndex   Int?
  finalRank    Int?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  matchesAsPlayer1 TournamentMatch[] @relation("MatchPlayer1")
  matchesAsPlayer2 TournamentMatch[] @relation("MatchPlayer2")
  matchesWon       TournamentMatch[] @relation("MatchWinner")

  @@unique([tournamentId, userId])
  @@unique([tournamentId, name])
  @@index([tournamentId, seed])
  @@map("tournament_participants")
}

model TournamentMatch {
  id           String      @id @default(cuid())
  tournamentId String
  stage        MatchStage
  round        Int
  position     Int
  groupIndex   Int?
  /// Display/order number inside the tournament (1..n).
  number       Int
  player1Id    String?
  player2Id    String?
  /// A slot that will never receive a player (bracket bye).
  player1Bye   Boolean     @default(false)
  player2Bye   Boolean     @default(false)
  score1       Int?
  score2       Int?
  winnerId     String?
  /// 1 or 2 — which slot won (also for byes, where there is no winner participant row change).
  winnerSlot   Int?
  status       MatchStatus @default(PENDING)
  nextMatchId  String?
  nextSlot     Int?
  loserMatchId String?
  loserSlot    Int?
  note         String?     @db.VarChar(200)
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tournament Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1    TournamentParticipant? @relation("MatchPlayer1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2    TournamentParticipant? @relation("MatchPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  winner     TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, number])
  @@index([tournamentId, stage, round, position])
  @@map("tournament_matches")
}

// ───────────── Online support (chat) ─────────────

enum SupportStatus {
  OPEN
  CLOSED
}

/// One support thread per user. A closed thread reopens when the user writes again.
model SupportConversation {
  id                 String        @id @default(cuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             SupportStatus @default(OPEN)
  lastMessageAt      DateTime      @default(now())
  /// Messages the other side has not read yet.
  unreadByStaff      Int           @default(0)
  unreadByUser       Int           @default(0)
  /// Last time the user's browser polled (used to decide whether to notify them by SMS/email).
  userLastSeenAt     DateTime?
  /// Throttle notifications.
  staffNotifiedAt    DateTime?
  customerNotifiedAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Author (null if the account was deleted).
  senderId       String?
  sender         User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  fromStaff      Boolean
  body           String              @db.VarChar(2000)
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@map("support_messages")
}

/// Frequently asked questions; suggested in the support chat while the user types (no external AI).
model SupportFaq {
  id           String   @id @default(cuid())
  question     String   @db.VarChar(200)
  answer       String   @db.VarChar(2000)
  /// Extra words/synonyms that should match this FAQ (space separated).
  keywords     String   @default("") @db.VarChar(300)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  /// Times the answer was opened from a suggestion / marked as helpful.
  openCount    Int      @default(0)
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("support_faqs")
}

// ───────────── 3D world: points, achievements, reward cards (docs/GAME_REWARDS.md) ─────────────

enum PointsEntryKind {
  ROUND
  ACHIEVEMENT
  REDEEM
  REFUND
  ADJUST
}

enum RewardChannel {
  IN_STORE
  ONLINE
  BOTH
}

/// ACTIVE past `expiresAt` is shown as expired; it is never stored as such.
enum RewardCodeStatus {
  ACTIVE
  USED
  CANCELLED
}

/// Points ledger: the balance is the sum of `amount` (earn +, spend −). Rows are never edited.
model GamePointsEntry {
  id            String          @id @default(cuid())
  userId        String
  kind          PointsEntryKind
  amount        Int
  game          String?         @db.VarChar(40)
  achievementId String?         @db.VarChar(60)
  redemptionId  String?
  note          String?         @db.VarChar(200)
  actorId       String?
  createdAt     DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@map("game_points_entries")
}

/// One row per achievement per account (the unique key stops double points).
model GameAchievementUnlock {
  userId        String
  achievementId String   @db.VarChar(60)
  points        Int
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("game_achievement_unlocks")
}

/// A discount card the manager offers for points.
model RewardCard {
  id              String        @id @default(cuid())
  title           String        @db.VarChar(80)
  description     String        @default("") @db.VarChar(300)
  pointsCost      Int
  discountPercent Int
  channel         RewardChannel @default(IN_STORE)
  validDays       Int           @default(30)
  /// How many of this card one account may take in 30 days (0 = no limit).
  limitPer30Days  Int           @default(1)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  redemptions RewardRedemption[]

  @@index([isActive, sortOrder])
  @@map("reward_cards")
}

/// A card a player took: its code, a snapshot of the card, and where it was used.
model RewardRedemption {
  id              String           @id @default(cuid())
  code            String           @unique @db.VarChar(20)
  userId          String
  cardId          String?
  title           String           @db.VarChar(80)
  discountPercent Int
  channel         RewardChannel
  pointsSpent     Int
  status          RewardCodeStatus @default(ACTIVE)
  expiresAt       DateTime
  usedAt          DateTime?
  /// Staff member who accepted it at the counter (in-store use).
  usedById        String?
  /// Online order that used it (cancelled orders give it back).
  orderId         String?          @unique
  createdAt       DateTime         @default(now())

  user   User        @relation("RewardOwner", fields: [userId], references: [id], onDelete: Cascade)
  card   RewardCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  usedBy User?       @relation("RewardStaff", fields: [usedById], references: [id], onDelete: SetNull)
  order  Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([cardId, userId, createdAt])
  @@index([status, createdAt])
  @@map("reward_redemptions")
}

/// «سازمان‌های طرف قرارداد» on the homepage (owner request 2026-10-31). Managed in Admin → تنظیمات سایت.
model ContractOrganization {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  logoId      String?
  /// Optional details shown in a dialog when `showDetails` is on.
  description String?  @db.VarChar(3000)
  terms       String?  @db.VarChar(5000)
  website     String?  @db.VarChar(300)
  showDetails Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logo Media? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@map("contract_organizations")
}

/// Sections of the «شهربازی اتم گیم» page (owner request 2026-10-31). Managed in Admin → تنظیمات سایت → شهربازی.
model ParkAttraction {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(120)
  description String   @db.VarChar(2000)
  imageId     String?
  /// Built-in photo under /public/atom-world (starting content from the 3D world); an uploaded image replaces it.
  staticImage String?  @db.VarChar(200)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@map("park_attractions")
}
