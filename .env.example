# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/atom_dev?schema=public"
# Random string, at least 32 chars:  openssl rand -base64 32
AUTH_SECRET=""
APP_URL="http://localhost:3000"
UPLOAD_DIR="./storage/uploads"

# Payments (disabled until a provider and credentials are supplied)
PAYMENT_PROVIDER="disabled"
PAYMENT_MERCHANT_ID=""

# SMS: "log" prints codes to the server log (development only)
SMS_PROVIDER="log"          # log | smsir
SMS_API_KEY=""
SMS_TEMPLATE_ID=""          # SMS.ir verify template ID
SMS_TEMPLATE_PARAM="CODE"   # template variable that receives the code

# Email: "log" prints emails to the server log (development only)
MAIL_PROVIDER="log"
SMTP_URL=""
MAIL_FROM=""
