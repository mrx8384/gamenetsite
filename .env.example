# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/atom_dev?schema=public"
# Random string, at least 32 chars:  openssl rand -base64 32
AUTH_SECRET=""
APP_URL="http://localhost:3000"
UPLOAD_DIR="./storage/uploads"

# Payments (disabled until a provider and credentials are supplied)
PAYMENT_PROVIDER="disabled"
PAYMENT_MERCHANT_ID=""

# SMS: "log" prints codes to the server log (development only)
SMS_PROVIDER="log"          # log | smsir
SMS_API_KEY=""
SMS_TEMPLATE_ID=""          # SMS.ir verify template ID
SMS_TEMPLATE_PARAM="CODE"   # template variable that receives the code

# Email: "log" prints emails to the server log (development only)
# «ادامه با گوگل»: OAuth client (Web application) from Google Cloud Console. Button shows only when both are set.
# Authorized redirect URI: https://www.atomgclub.ir/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Email: "log" (server log only) or "smtp". With smtp give either SMTP_URL or SMTP_HOST/USER/PASSWORD.
# Port 465 = TLS (default), 587 = STARTTLS. Example mailbox from the cPanel host: info@atomgclub.ir
MAIL_PROVIDER="log"
SMTP_URL=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
